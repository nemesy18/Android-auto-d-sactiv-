<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:id="@+id/status" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingBottom="24dp"/>
<Button android:id="@+id/permission" android:text="Autoriser Shizuku" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/openShizuku" android:text="Ouvrir / démarrer Shizuku" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/disable" android:text="Désactiver Android Auto" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/enable" android:text="Réactiver Android Auto" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Après installation, ajoute la tuile ‘Android Auto ON/OFF’ depuis Modifier les boutons du panneau rapide Samsung." android:paddingTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
